# Copy to .env.local to run against a real database and a real staff password.
#
# ─────────────────────────────────────────────────────────────────────────────
# WITH NONE OF THIS SET, THE APP STILL RUNS.
# ─────────────────────────────────────────────────────────────────────────────
# `npm run dev` with no .env.local at all serves the whole guest journey and the
# whole admin from the in-memory seed in src/lib/data/mock.ts, behind the
# development sign-in stand-in. That is how the app is demoed today, and it is
# what the Vercel prototype deploy runs on.
#
# Two variables flip it to the real thing, independently:
#   DATABASE_URL         → src/lib/data/index.ts picks postgresRepo over mockRepo
#   ADMIN_PASSWORD_HASH  → src/lib/auth/index.ts picks passwordAuth over mockAuth
#
# In production (ECS) all three secrets come from AWS Secrets Manager, never from
# a file. See deploy/README.md.

# ─────────────────────────────────────────────────────────────────────────────
# Database — RDS Postgres
# ─────────────────────────────────────────────────────────────────────────────
# Server-only. Deliberately NOT prefixed NEXT_PUBLIC_: that prefix inlines a
# value into the browser bundle, and this one contains the database password.
#
# postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Path to the AWS RDS CA bundle, so the TLS connection verifies the server
# certificate instead of merely encrypting. The container image bakes one in at
# /etc/ssl/rds/rds-ca-bundle.pem. Locally, download it with:
#   curl -o rds-ca-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
#
# Left unset, the app still uses TLS but does NOT verify the certificate, and
# logs a warning saying exactly that on first connection. Do not leave it unset
# for anything holding real inventory.
PGSSLROOTCERT=

# Set to `disable` to turn TLS off entirely. This exists so the Postgres code
# path can be exercised against a local Postgres (docker, homebrew) that has no
# certificate — otherwise there would be no way to run it before RDS exists.
# LOCAL DEVELOPMENT ONLY. It logs a warning every time it is used, and RDS with
# rds.force_ssl=1 will refuse the connection anyway.
PGSSLMODE=

# Connections in this process's pool. Default 10.
# `tasks × PGPOOL_MAX` must stay under the RDS max_connections — see
# deploy/README.md before raising it.
PGPOOL_MAX=

# ─────────────────────────────────────────────────────────────────────────────
# /admin sign-in
# ─────────────────────────────────────────────────────────────────────────────
# The real staff login: one shared password (plan v2 §11 — no per-user accounts
# in v1), stored as a scrypt hash, never as plaintext.
#
# Generate one with:
#   npm run hash-password
#
# and paste the whole `scrypt$...` string here. Setting this removes the red
# development-sign-in banner from every admin screen, so if you can still see the
# banner, this variable did not reach the app.
ADMIN_PASSWORD_HASH=

# HMAC key for the admin session cookie. Required whenever ADMIN_PASSWORD_HASH is
# set; must be at least 32 characters, and the app throws rather than starting
# with a weak one — a guessable signing key is a forgeable admin session.
#   openssl rand -base64 48
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# /admin sign-in — DEVELOPMENT STAND-IN (used only when ADMIN_PASSWORD_HASH is
# unset)
# ─────────────────────────────────────────────────────────────────────────────
# One password, compared in constant time, setting a signed httpOnly cookie for
# 12 hours. It is NOT authentication — no account, no audit trail, and the
# default is published in this file and in the README. Every admin screen shows a
# red banner saying so while it is active. Do not open a deployment running in
# this mode to the public.
#
# Unset, the stand-in password is `sake-admin`.
ADMIN_DEV_PASSWORD=
